// Backend URL - using relative URLs for nginx proxy
const BACKEND_URL = '';

// State management
let currentPlaylistId = null;
let selectedTracks = new Set();

// DOM elements
const authStatus = document.getElementById('authStatus');
const loginBtn = document.getElementById('loginBtn');
const logoutBtn = document.getElementById('logoutBtn');
const welcomeSection = document.getElementById('welcomeSection');
const navTabs = document.getElementById('navTabs');
const tabPlaylists = document.getElementById('tabPlaylists');
const tabManageSongs = document.getElementById('tabManageSongs');
const playlistsSection = document.getElementById('playlistsSection');
const tracksSection = document.getElementById('tracksSection');
const manageSongsSection = document.getElementById('manageSongsSection');
const playlistsLoading = document.getElementById('playlistsLoading');
const playlistsGrid = document.getElementById('playlistsGrid');
const tracksLoading = document.getElementById('tracksLoading');
const tracksList = document.getElementById('tracksList');
const playlistTitle = document.getElementById('playlistTitle');
const backToPlaylists = document.getElementById('backToPlaylists');
const importControls = document.getElementById('importControls');
const importBtn = document.getElementById('importBtn');
const selectedCount = document.getElementById('selectedCount');
const songsLoading = document.getElementById('songsLoading');
const songsTable = document.getElementById('songsTable');
const songsTableBody = document.getElementById('songsTableBody');
const errorMessage = document.getElementById('errorMessage');
const successMessage = document.getElementById('successMessage');

// Initialize on page load
window.addEventListener('DOMContentLoaded', async () => {
    // Check URL parameters for auth status
    const urlParams = new URLSearchParams(window.location.search);
    const authParam = urlParams.get('auth');
    const errorParam = urlParams.get('error');

    if (authParam === 'success') {
        showSuccess('Successfully authenticated with Spotify!');
        // Clean up URL
        window.history.replaceState({}, document.title, window.location.pathname);
    } else if (errorParam) {
        showError(`Authentication error: ${errorParam}`);
        // Clean up URL
        window.history.replaceState({}, document.title, window.location.pathname);
    }

    // Check authentication status
    await checkAuthStatus();
});

// Check if user is authenticated
async function checkAuthStatus() {
    try {
        const response = await fetch(`${BACKEND_URL}/api/admin/auth-status`, {
            credentials: 'include'
        });
        const data = await response.json();

        if (data.authenticated) {
            updateUIForAuthenticatedUser();
            await loadPlaylists();
        } else {
            updateUIForUnauthenticatedUser();
        }
    } catch (error) {
        console.error('Error checking auth status:', error);
        updateUIForUnauthenticatedUser();
    }
}

// Update UI for authenticated user
function updateUIForAuthenticatedUser() {
    authStatus.textContent = 'Authenticated';
    authStatus.className = 'auth-status authenticated';
    loginBtn.classList.add('hidden');
    logoutBtn.classList.remove('hidden');
    welcomeSection.classList.add('hidden');
    navTabs.classList.remove('hidden');
    playlistsSection.classList.remove('hidden');

    // Set up tab navigation
    setupTabNavigation();
}

// Update UI for unauthenticated user
function updateUIForUnauthenticatedUser() {
    authStatus.textContent = 'Not Authenticated';
    authStatus.className = 'auth-status not-authenticated';
    loginBtn.classList.remove('hidden');
    logoutBtn.classList.add('hidden');
    welcomeSection.classList.remove('hidden');
    navTabs.classList.add('hidden');
    playlistsSection.classList.add('hidden');
    tracksSection.classList.add('hidden');
    manageSongsSection.classList.add('hidden');
}

// Setup tab navigation
function setupTabNavigation() {
    tabPlaylists.addEventListener('click', () => {
        switchTab('playlists');
    });

    tabManageSongs.addEventListener('click', () => {
        switchTab('manageSongs');
    });
}

// Switch between tabs
function switchTab(tab) {
    // Update tab active states
    document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));

    if (tab === 'playlists') {
        tabPlaylists.classList.add('active');
        playlistsSection.classList.remove('hidden');
        tracksSection.classList.add('hidden');
        manageSongsSection.classList.add('hidden');
    } else if (tab === 'manageSongs') {
        tabManageSongs.classList.add('active');
        playlistsSection.classList.add('hidden');
        tracksSection.classList.add('hidden');
        manageSongsSection.classList.remove('hidden');
        loadSongs();
    }
}

// Logout handler
logoutBtn.addEventListener('click', async () => {
    try {
        await fetch(`${BACKEND_URL}/api/admin/spotify/logout`, {
            credentials: 'include'
        });
        updateUIForUnauthenticatedUser();
        showSuccess('Logged out successfully');
    } catch (error) {
        console.error('Error logging out:', error);
        showError('Failed to logout');
    }
});

// Load user's Spotify playlists
async function loadPlaylists() {
    playlistsLoading.classList.remove('hidden');
    playlistsGrid.innerHTML = '';

    try {
        const response = await fetch(`${BACKEND_URL}/api/admin/spotify/playlists`, {
            credentials: 'include'
        });

        if (!response.ok) {
            throw new Error('Failed to fetch playlists');
        }

        const playlists = await response.json();
        playlistsLoading.classList.add('hidden');

        if (playlists.length === 0) {
            playlistsGrid.innerHTML = '<p>No playlists found. Create some playlists in Spotify first!</p>';
            return;
        }

        playlists.forEach(playlist => {
            const card = createPlaylistCard(playlist);
            playlistsGrid.appendChild(card);
        });
    } catch (error) {
        console.error('Error loading playlists:', error);
        playlistsLoading.classList.add('hidden');
        showError('Failed to load playlists. Please try again.');
    }
}

// Create playlist card element
function createPlaylistCard(playlist) {
    const card = document.createElement('div');
    card.className = 'playlist-card';
    card.onclick = () => loadPlaylistTracks(playlist.id, playlist.name);

    const imageUrl = playlist.images && playlist.images.length > 0
        ? playlist.images[0].url
        : 'https://via.placeholder.com/250x250?text=No+Image';

    card.innerHTML = `
        <img src="${imageUrl}" alt="${playlist.name}">
        <h3>${playlist.name}</h3>
        <p>${playlist.tracks.total} tracks • ${playlist.owner}</p>
    `;

    return card;
}

// Load tracks from a playlist
async function loadPlaylistTracks(playlistId, playlistName) {
    currentPlaylistId = playlistId;
    selectedTracks.clear();

    playlistsSection.classList.add('hidden');
    tracksSection.classList.remove('hidden');
    tracksLoading.classList.remove('hidden');
    tracksList.innerHTML = '';
    playlistTitle.textContent = playlistName;
    importControls.classList.add('hidden');
    updateSelectedCount();

    try {
        const response = await fetch(`${BACKEND_URL}/api/admin/spotify/playlist/${playlistId}/tracks`, {
            credentials: 'include'
        });

        if (!response.ok) {
            throw new Error('Failed to fetch tracks');
        }

        const tracks = await response.json();
        tracksLoading.classList.add('hidden');

        if (tracks.length === 0) {
            tracksList.innerHTML = '<p>No tracks found in this playlist.</p>';
            return;
        }

        tracks.forEach(track => {
            const item = createTrackItem(track);
            tracksList.appendChild(item);
        });

        importControls.classList.remove('hidden');
    } catch (error) {
        console.error('Error loading tracks:', error);
        tracksLoading.classList.add('hidden');
        showError('Failed to load tracks. Please try again.');
    }
}

// Create track item element
function createTrackItem(track) {
    const item = document.createElement('div');
    item.className = 'track-item';

    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.id = `track-${track.id}`;
    checkbox.onchange = (e) => handleTrackSelection(e, track);

    const imageUrl = track.albumArt || 'https://via.placeholder.com/60x60?text=No+Image';

    item.innerHTML = `
        <img src="${imageUrl}" alt="${track.name}">
        <div class="track-info">
            <h4>${track.name}</h4>
            <p>${track.artist} • ${track.album}</p>
        </div>
    `;

    item.insertBefore(checkbox, item.firstChild);

    return item;
}

// Handle track selection
function handleTrackSelection(event, track) {
    if (event.target.checked) {
        if (selectedTracks.size >= 10) {
            event.target.checked = false;
            showError('You can only select up to 10 tracks at a time.');
            return;
        }
        selectedTracks.add(track);
    } else {
        selectedTracks.delete(track);
    }
    updateSelectedCount();
}

// Update selected count display
function updateSelectedCount() {
    selectedCount.textContent = selectedTracks.size;
}

// Back to playlists
backToPlaylists.addEventListener('click', (e) => {
    e.preventDefault();
    tracksSection.classList.add('hidden');
    playlistsSection.classList.remove('hidden');
    selectedTracks.clear();
});

// Import selected tracks
importBtn.addEventListener('click', async () => {
    if (selectedTracks.size === 0) {
        showError('Please select at least one track to import.');
        return;
    }

    importBtn.disabled = true;
    importBtn.textContent = 'Importing...';

    try {
        const tracks = Array.from(selectedTracks);
        const response = await fetch(`${BACKEND_URL}/api/admin/spotify/import-playlist`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            credentials: 'include',
            body: JSON.stringify({ tracks })
        });

        if (!response.ok) {
            throw new Error('Failed to import tracks');
        }

        const result = await response.json();

        // Build detailed success message
        let message = `Successfully imported ${result.songs.length} songs!\n`;
        if (result.previewsDownloaded > 0) {
            message += `✓ ${result.previewsDownloaded} Spotify previews auto-downloaded (30s clips)\n`;
        }
        if (result.noPreviewAvailable > 0) {
            message += `⚠ ${result.noPreviewAvailable} songs need manual upload (no Spotify preview available)`;
        }

        showSuccess(message);

        // Reload songs table to show new imports
        await loadSongs();

        // Reset selection
        selectedTracks.clear();
        tracksList.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
        updateSelectedCount();

    } catch (error) {
        console.error('Error importing tracks:', error);
        showError('Failed to import tracks. Please try again.');
    } finally {
        importBtn.disabled = false;
        importBtn.textContent = 'Import Selected Songs';
    }
});

// Show error message
function showError(message) {
    errorMessage.textContent = message;
    errorMessage.classList.remove('hidden');
    successMessage.classList.add('hidden');
    setTimeout(() => {
        errorMessage.classList.add('hidden');
    }, 5000);
}

// Show success message
function showSuccess(message) {
    successMessage.textContent = message;
    successMessage.classList.remove('hidden');
    errorMessage.classList.add('hidden');
    setTimeout(() => {
        successMessage.classList.add('hidden');
    }, 5000);
}

// ========================================
// SONG MANAGEMENT FUNCTIONS
// ========================================

// Load all songs from database
async function loadSongs() {
    songsLoading.classList.remove('hidden');
    songsTable.classList.add('hidden');
    songsTableBody.innerHTML = '';

    try {
        const response = await fetch(`${BACKEND_URL}/api/admin/songs`, {
            credentials: 'include'
        });

        if (!response.ok) {
            throw new Error('Failed to fetch songs');
        }

        const songs = await response.json();
        songsLoading.classList.add('hidden');

        if (songs.length === 0) {
            songsTableBody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 40px;">No songs found. Import some from Spotify first!</td></tr>';
            songsTable.classList.remove('hidden');
            return;
        }

        songs.forEach(song => {
            const row = createSongRow(song);
            songsTableBody.appendChild(row);
        });

        songsTable.classList.remove('hidden');
    } catch (error) {
        console.error('Error loading songs:', error);
        songsLoading.classList.add('hidden');
        showError('Failed to load songs. Please try again.');
    }
}

// Create song table row
function createSongRow(song) {
    const row = document.createElement('tr');

    const albumArt = song.album_art_url || 'https://via.placeholder.com/40x40?text=No+Image';

    // Determine audio status and badge text
    let statusBadgeClass = 'no-audio';
    let statusText = '⚠ No Audio';

    if (song.has_audio) {
        if (song.audio_source === 'spotify_preview') {
            statusBadgeClass = 'has-preview';
            statusText = '🎵 Preview (30s)';
        } else if (song.audio_source === 'manual_upload') {
            statusBadgeClass = 'has-audio';
            statusText = '✓ Full Song';
        } else {
            statusBadgeClass = 'has-audio';
            statusText = '✓ Has Audio';
        }
    }

    row.innerHTML = `
        <td><img src="${albumArt}" alt="${song.song_name}" class="album-art-small"></td>
        <td>${song.song_name}</td>
        <td>${song.artist_name}</td>
        <td>${song.album_name || 'N/A'}</td>
        <td>
            <span class="status-badge ${statusBadgeClass}">
                ${statusText}
            </span>
        </td>
        <td>
            ${song.has_audio ?
                `<button class="btn btn-secondary btn-small" onclick="replaceAudio('${song._id}')">Replace Audio</button>` :
                `<button class="btn btn-primary btn-small" onclick="uploadAudioForSong('${song._id}')">Upload Audio</button>`
            }
            <button class="btn btn-danger btn-small" onclick="deleteSong('${song._id}')">Delete</button>
        </td>
    `;

    return row;
}

// Upload audio for a song
window.uploadAudioForSong = async function(songId) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'audio/mp3,audio/mpeg';

    input.onchange = async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        // Validate file type
        if (!file.type.match('audio/(mp3|mpeg)') && !file.name.endsWith('.mp3')) {
            showError('Please select an MP3 file');
            return;
        }

        // Validate file size (10MB max)
        if (file.size > 10 * 1024 * 1024) {
            showError('File size must be less than 10MB');
            return;
        }

        const formData = new FormData();
        formData.append('audioFile', file);
        formData.append('songId', songId);

        try {
            showSuccess('Uploading audio file...');

            const response = await fetch(`${BACKEND_URL}/api/admin/upload-audio/${songId}`, {
                method: 'POST',
                credentials: 'include',
                body: formData
            });

            if (!response.ok) {
                const error = await response.json();
                throw new Error(error.error || 'Upload failed');
            }

            const result = await response.json();
            showSuccess('Audio file uploaded successfully!');

            // Reload songs table
            await loadSongs();
        } catch (error) {
            console.error('Error uploading audio:', error);
            showError(`Failed to upload audio: ${error.message}`);
        }
    };

    input.click();
};

// Replace audio for a song (same as upload)
window.replaceAudio = window.uploadAudioForSong;

// Delete a song
window.deleteSong = async function(songId) {
    if (!confirm('Are you sure you want to delete this song? This action cannot be undone.')) {
        return;
    }

    try {
        const response = await fetch(`${BACKEND_URL}/api/admin/songs/${songId}`, {
            method: 'DELETE',
            credentials: 'include'
        });

        if (!response.ok) {
            throw new Error('Failed to delete song');
        }

        showSuccess('Song deleted successfully');
        await loadSongs();
    } catch (error) {
        console.error('Error deleting song:', error);
        showError('Failed to delete song. Please try again.');
    }
};
