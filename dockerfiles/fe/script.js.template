const backendUrl = ''; // Using relative URLs for nginx proxy
let songs = []; // Will be loaded dynamically from API
let songData = []; // Full song data from API
const songBackgrounds = {}; // Will use album art from Spotify

let currentSongIndex = 0;
let guesses = [];
let playerName = '';
let currentLeaderboardFilter = 'all';
let songsLoaded = false;

// DOM elements
const audioElement = document.getElementById('audioPlayer');
const resultElement = document.getElementById('result');
const correctAnswersElement = document.getElementById('correctAnswers');
const playSongBtn = document.getElementById('playSongBtn');
const submitGuessBtn = document.getElementById('submitGuessBtn');
const submitAllGuessesBtn = document.getElementById('submitAllGuessesBtn');
const setPlayerNameBtn = document.getElementById('setPlayerNameBtn');
const playerNameInput = document.getElementById('playerNameInput');
const topPlayerElement = document.getElementById('topPlayer');
const progressIndicator = document.getElementById('progressIndicator');
const audioControls = document.getElementById('audioControls');
const playPauseBtn = document.getElementById('playPauseBtn');
const replayBtn = document.getElementById('replayBtn');
const progressBarContainer = document.getElementById('progressBarContainer');
const progressBar = document.getElementById('progressBar');
const songFeedback = document.getElementById('songFeedback');
const playAgainBtn = document.getElementById('playAgainBtn');
const leaderboardSection = document.getElementById('leaderboardSection');
const leaderboardList = document.getElementById('leaderboardList');
const filterAllTime = document.getElementById('filterAllTime');
const filterWeekly = document.getElementById('filterWeekly');
const filterDaily = document.getElementById('filterDaily');

// Load available songs from API
async function loadAvailableSongs() {
    try {
        resultElement.innerText = 'Loading available songs...';
        const response = await fetch(`${backendUrl}/api/available-songs`);

        if (!response.ok) {
            throw new Error('Failed to load songs');
        }

        songData = await response.json();

        if (songData.length === 0) {
            resultElement.innerText = 'No songs available yet. Please contact the admin to upload songs.';
            playSongBtn.disabled = true;
            return false;
        }

        // Extract song file names for the game
        songs = songData.map(song => song.songFile);

        // Build song backgrounds using album art
        songData.forEach(song => {
            if (song.album_art_url) {
                songBackgrounds[song.songFile] = song.album_art_url;
            }
        });

        songsLoaded = true;
        resultElement.innerText = `${songs.length} songs loaded! Enter your name to start playing.`;
        return true;
    } catch (error) {
        console.error('Error loading songs:', error);
        resultElement.innerText = 'Error loading songs. Please refresh the page and try again.';
        playSongBtn.disabled = true;
        return false;
    }
}

// Load player name from localStorage and load songs
window.addEventListener('DOMContentLoaded', async () => {
    const savedName = localStorage.getItem('playerName');
    if (savedName) {
        playerNameInput.value = savedName;
    }

    // Load available songs on page load
    await loadAvailableSongs();
});

function updateBackgroundImage(song) {
    const background = songBackgrounds[song] || 'images/default-background.jpg';
    // For external URLs (Spotify album art), use them directly
    // For local images, use the images directory
    if (background.startsWith('http')) {
        document.body.style.backgroundImage = `url(${background})`;
    } else {
        document.body.style.backgroundImage = `url(${background})`;
    }
    document.body.style.backgroundSize = 'cover';
    document.body.style.backgroundPosition = 'center';
}

function updateProgressIndicator() {
    progressIndicator.style.display = 'block';
    progressIndicator.innerText = `Song ${currentSongIndex + 1} of ${songs.length}`;
}

function updateProgressBar() {
    if (!audioElement.duration) return;
    const percent = (audioElement.currentTime / audioElement.duration) * 100;
    progressBar.style.width = percent + '%';
}

function playNextSong() {
    if (currentSongIndex < songs.length) {
        const currentSong = songs[currentSongIndex];
        audioElement.src = `/audio/${currentSong}.mp3`;
        audioElement.play();
        updateBackgroundImage(currentSong);
        updateProgressIndicator();

        // Show audio controls and progress bar
        audioControls.style.display = 'flex';
        progressBarContainer.style.display = 'block';
        playPauseBtn.innerText = 'Pause';

        resultElement.innerText = `Playing: ${currentSong}`;
        currentSongIndex++;
        playSongBtn.disabled = true;
        submitGuessBtn.disabled = false;
        songFeedback.innerHTML = ''; // Clear previous feedback
    } else {
        resultElement.innerText = 'All songs have been played. Submit your guesses for the final results.';
        playSongBtn.disabled = true;
        submitAllGuessesBtn.disabled = false;
        audioControls.style.display = 'none';
        progressBarContainer.style.display = 'none';
    }
}

async function submitGuess() {
    const songGuessInput = document.getElementById('songGuessInput');
    const artistGuessInput = document.getElementById('artistGuessInput');

    if (songGuessInput.value.trim() && artistGuessInput.value.trim()) {
        const songFile = songs[currentSongIndex - 1];
        const songGuess = songGuessInput.value.trim();
        const artistGuess = artistGuessInput.value.trim();

        guesses.push({
            songFile: songFile,
            songGuess: songGuess,
            artistGuess: artistGuess
        });

        // Optional: Get immediate feedback
        try {
            const response = await fetch(`${backendUrl}/validate-guess`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ songFile, songGuess, artistGuess })
            });

            if (response.ok) {
                const result = await response.json();
                showImmediateFeedback(result);
            }
        } catch (error) {
            console.log('Immediate feedback not available, continuing...');
        }

        songGuessInput.value = '';
        artistGuessInput.value = '';
        resultElement.innerText = 'Guess submitted! Get ready for the next song.';

        submitGuessBtn.disabled = true;

        // Stop audio and hide controls
        audioElement.pause();
        audioControls.style.display = 'none';
        progressBarContainer.style.display = 'none';

        setTimeout(playNextSong, 2000);
    } else {
        resultElement.innerText = 'Please enter both a song and an artist guess.';
    }
}

function showImmediateFeedback(result) {
    const { correctSong, correctArtist, correctAnswer } = result;
    let feedbackHTML = '<div class="feedback ';

    if (correctSong && correctArtist) {
        feedbackHTML += 'feedback-correct">Perfect! Both correct!</div>';
    } else if (correctSong || correctArtist) {
        feedbackHTML += 'feedback-incorrect">';
        feedbackHTML += correctSong ? 'Song correct! ' : 'Song incorrect. ';
        feedbackHTML += correctArtist ? 'Artist correct!' : 'Artist incorrect.';
        feedbackHTML += `<br>Answer: ${correctAnswer.song} by ${correctAnswer.artist}</div>`;
    } else {
        feedbackHTML += 'feedback-incorrect">Both incorrect.<br>Answer: ';
        feedbackHTML += `${correctAnswer.song} by ${correctAnswer.artist}</div>`;
    }

    songFeedback.innerHTML = feedbackHTML;
}

async function submitAllGuesses() {
    submitAllGuessesBtn.disabled = true;
    submitAllGuessesBtn.innerText = 'Submitting...';

    try {
        const response = await fetch(`${backendUrl}/submit-guesses`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ playerName, guesses })
        });

        if (!response.ok) {
            throw new Error('Failed to submit guesses');
        }

        const result = await response.json();

        const totalCorrectSongGuesses = result.correctSongGuesses || 0;
        const totalCorrectArtistGuesses = result.correctArtistGuesses || 0;
        const correctAnswers = result.correctAnswers || [];

        resultElement.innerHTML = `
            <h2>Game Over!</h2>
            <p>You got ${totalCorrectSongGuesses} song(s) and ${totalCorrectArtistGuesses} artist(s) correct.</p>
            <p><strong>Total Score: ${totalCorrectSongGuesses + totalCorrectArtistGuesses} out of ${songs.length * 2}</strong></p>
        `;

        correctAnswersElement.innerHTML = '<h3>Correct Answers:</h3>' +
            correctAnswers.map(ans => `<p>${ans}</p>`).join('');

        // Show play again button and leaderboard
        playAgainBtn.style.display = 'block';
        leaderboardSection.style.display = 'block';

        // Load leaderboard
        await loadLeaderboard('all');

        submitAllGuessesBtn.innerText = 'Submit All Guesses';
    } catch (error) {
        console.error('Error submitting guesses:', error);
        resultElement.innerText = 'Error: Could not submit your guesses. Please try again.';
        submitAllGuessesBtn.disabled = false;
        submitAllGuessesBtn.innerText = 'Submit All Guesses';
    }
}

async function loadLeaderboard(filter) {
    try {
        const response = await fetch(`${backendUrl}/leaderboard?filter=${filter}`);
        if (!response.ok) throw new Error('Failed to load leaderboard');

        const leaderboard = await response.json();
        displayLeaderboard(leaderboard);
    } catch (error) {
        console.error('Error loading leaderboard:', error);
        leaderboardList.innerHTML = '<p>Error loading leaderboard</p>';
    }
}

function displayLeaderboard(leaderboard) {
    if (!leaderboard || leaderboard.length === 0) {
        leaderboardList.innerHTML = '<p>No players yet. Be the first!</p>';
        return;
    }

    leaderboardList.innerHTML = leaderboard.map((player, index) => `
        <div class="leaderboard-entry">
            <span>${index + 1}. ${player.playerName}</span>
            <span>${player.totalScore} points</span>
        </div>
    `).join('');
}

async function resetGame() {
    currentSongIndex = 0;
    guesses = [];

    // Reset UI
    resultElement.innerHTML = '';
    correctAnswersElement.innerHTML = '';
    songFeedback.innerHTML = '';
    progressIndicator.style.display = 'none';
    audioControls.style.display = 'none';
    progressBarContainer.style.display = 'none';
    playAgainBtn.style.display = 'none';
    leaderboardSection.style.display = 'none';

    // Reset buttons
    playSongBtn.disabled = false;
    submitGuessBtn.disabled = true;
    submitAllGuessesBtn.disabled = true;

    // Clear inputs
    document.getElementById('songGuessInput').value = '';
    document.getElementById('artistGuessInput').value = '';

    // Reload songs in case new ones were added
    await loadAvailableSongs();

    if (songsLoaded && songs.length > 0) {
        resultElement.innerText = `Welcome back, ${playerName}! ${songs.length} songs ready. Click "Play Song" to start.`;
    } else {
        resultElement.innerText = 'No songs available at the moment.';
        playSongBtn.disabled = true;
    }
}

// Event Listeners
setPlayerNameBtn.addEventListener('click', () => {
    const name = playerNameInput.value.trim();
    if (name) {
        if (!songsLoaded || songs.length === 0) {
            resultElement.innerText = 'No songs available. Please wait or contact admin.';
            return;
        }

        playerName = name;
        // Save to localStorage
        localStorage.setItem('playerName', name);

        resultElement.innerText = `Welcome, ${playerName}! ${songs.length} songs ready. Click "Play Song" to start.`;
        playSongBtn.disabled = false;
        setPlayerNameBtn.disabled = true;
        playerNameInput.disabled = true;
    } else {
        resultElement.innerText = 'Please enter a valid name to start.';
    }
});

playSongBtn.addEventListener('click', playNextSong);
submitGuessBtn.addEventListener('click', submitGuess);
submitAllGuessesBtn.addEventListener('click', submitAllGuesses);
playAgainBtn.addEventListener('click', resetGame);

// Audio control event listeners
playPauseBtn.addEventListener('click', () => {
    if (audioElement.paused) {
        audioElement.play();
        playPauseBtn.innerText = 'Pause';
    } else {
        audioElement.pause();
        playPauseBtn.innerText = 'Play';
    }
});

replayBtn.addEventListener('click', () => {
    audioElement.currentTime = 0;
    audioElement.play();
    playPauseBtn.innerText = 'Pause';
});

// Update progress bar
audioElement.addEventListener('timeupdate', updateProgressBar);

audioElement.addEventListener('ended', () => {
    submitGuessBtn.disabled = false;
    playPauseBtn.innerText = 'Play';
});

// Leaderboard filter event listeners
filterAllTime.addEventListener('click', () => {
    currentLeaderboardFilter = 'all';
    loadLeaderboard('all');
    updateFilterButtons();
});

filterWeekly.addEventListener('click', () => {
    currentLeaderboardFilter = 'weekly';
    loadLeaderboard('weekly');
    updateFilterButtons();
});

filterDaily.addEventListener('click', () => {
    currentLeaderboardFilter = 'daily';
    loadLeaderboard('daily');
    updateFilterButtons();
});

function updateFilterButtons() {
    filterAllTime.classList.remove('filter-active');
    filterWeekly.classList.remove('filter-active');
    filterDaily.classList.remove('filter-active');

    switch(currentLeaderboardFilter) {
        case 'all':
            filterAllTime.classList.add('filter-active');
            break;
        case 'weekly':
            filterWeekly.classList.add('filter-active');
            break;
        case 'daily':
            filterDaily.classList.add('filter-active');
            break;
    }
}
